# Copy this file to ".env" (the dev/build scripts do this automatically if it is missing).

# SQLite database file, relative to the prisma/ folder.
DATABASE_URL="file:./dev.db"

# Optional: a free Pexels API key (https://www.pexels.com/api/) switches ViewTube
# from the bundled demo catalogue to live Pexels videos. Leave empty for demo mode.
# The key is only read on the server and is never sent to the browser.
PEXELS_API_KEY=""
